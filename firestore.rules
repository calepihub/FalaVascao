rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable validation & RBAC primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwnerEmail() {
      return isVerified() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'tazmaniacrvg@gmail.com';
    }

    function isAdmin() {
      return isOwnerEmail() || (
        isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
      );
    }

    function isValidPermissions(perms) {
      return perms is map &&
        perms.keys().hasAll(['canPostMural', 'canUseTactics', 'canUseAdvancedTools', 'canModerate']) &&
        perms.keys().hasOnly(['canPostMural', 'canUseTactics', 'canUseAdvancedTools', 'canModerate']) &&
        perms.canPostMural is bool &&
        perms.canUseTactics is bool &&
        perms.canUseAdvancedTools is bool &&
        perms.canModerate is bool;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'status', 'permissions', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'name', 'avatar', 'isOnline', 'lastSeenAt', 'role', 'status', 'permissions', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500)) &&
        (!('isOnline' in data) || data.isOnline is bool) &&
        (!('lastSeenAt' in data) || data.lastSeenAt is timestamp) &&
        data.role in ['owner', 'admin', 'moderator', 'vip', 'member'] &&
        data.status in ['active', 'pending', 'blocked'] &&
        isValidPermissions(data.permissions) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminMessage(data) {
      return data.keys().hasAll(['recipientUid', 'senderUid', 'senderName', 'message', 'acknowledged', 'createdAt']) &&
        data.keys().hasOnly(['recipientUid', 'senderUid', 'senderName', 'message', 'acknowledged', 'createdAt', 'acknowledgedAt', 'replyText', 'repliedAt']) &&
        isValidId(data.recipientUid) &&
        isValidId(data.senderUid) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 1000 &&
        data.acknowledged is bool &&
        data.createdAt is timestamp &&
        (!('acknowledgedAt' in data) || data.acknowledgedAt is timestamp) &&
        (!('replyText' in data) || (data.replyText is string && data.replyText.size() >= 1 && data.replyText.size() <= 1000)) &&
        (!('repliedAt' in data) || data.repliedAt is timestamp);
    }

    function isValidAdminReply(data) {
      return data.keys().hasAll([
          'senderUid',
          'senderName',
          'parentMessageId',
          'parentMessagePreview',
          'replyText',
          'readByAdmin',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'senderUid',
          'senderName',
          'parentMessageId',
          'parentMessagePreview',
          'replyText',
          'readByAdmin',
          'createdAt',
          'readAt'
        ]) &&
        isValidId(data.senderUid) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
        isValidId(data.parentMessageId) &&
        data.parentMessagePreview is string && data.parentMessagePreview.size() <= 200 &&
        data.replyText is string && data.replyText.size() >= 1 && data.replyText.size() <= 1000 &&
        data.readByAdmin is bool &&
        data.createdAt is timestamp &&
        (!('readAt' in data) || data.readAt is timestamp);
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
          'muralVisible',
          'muralPublicPosting',
          'tacticsVisible',
          'advancedToolsVisible',
          'liveStreamsVisible',
          'kickBannerVisible',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'muralVisible',
          'muralPublicPosting',
          'tacticsVisible',
          'advancedToolsVisible',
          'liveStreamsVisible',
          'kickBannerVisible',
          'updatedAt'
        ]) &&
        data.muralVisible is bool &&
        data.muralPublicPosting is bool &&
        data.tacticsVisible is bool &&
        data.advancedToolsVisible is bool &&
        data.liveStreamsVisible is bool &&
        data.kickBannerVisible is bool &&
        data.updatedAt is timestamp;
    }

    function isValidCommunityLineup(data) {
      return data.keys().hasAll(['authorUid', 'author', 'title', 'opponentClub', 'formation', 'likes', 'publishedAt']) &&
        data.keys().hasOnly([
          'authorUid',
          'author',
          'authorAvatar',
          'authorRole',
          'title',
          'opponentClub',
          'formation',
          'players',
          'imageUrl',
          'likes',
          'publishedAt'
        ]) &&
        isValidId(data.authorUid) &&
        data.author is string && data.author.size() >= 1 && data.author.size() <= 120 &&
        (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 500)) &&
        (!('authorRole' in data) || (data.authorRole is string && data.authorRole.size() <= 30)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.opponentClub is string && data.opponentClub.size() <= 100 &&
        data.formation is string && data.formation.size() <= 30 &&
        (!('players' in data) || (data.players is list && data.players.size() <= 25 && (data.players.size() == 0 || data.players[0] is map))) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 900000)) &&
        data.likes is int && data.likes >= 0 &&
        data.publishedAt is timestamp;
    }

    function canUserPostMural() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.canPostMural == true;
    }

    function isValidTacticalDoc(data) {
      return data.keys().hasAll(['ownerUid', 'kind', 'payload', 'updatedAt']) &&
        data.keys().hasOnly(['ownerUid', 'kind', 'payload', 'updatedAt']) &&
        isValidId(data.ownerUid) &&
        data.kind in ['lineup', 'play', 'board', 'speculated_squad'] &&
        data.payload is map &&
        data.updatedAt is timestamp;
    }

    // 1. Users collection (strict PII isolation + zero self-escalation)
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isVerified() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUser(incoming()) &&
        incoming().uid == request.auth.uid &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        incoming().email.lower() == request.auth.token.email.lower() &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwnerEmail() &&
            incoming().role == 'owner' &&
            incoming().status == 'active' &&
            incoming().permissions.canPostMural == true &&
            incoming().permissions.canUseTactics == true &&
            incoming().permissions.canUseAdvancedTools == true &&
            incoming().permissions.canModerate == true
          ) || (
            !isOwnerEmail() &&
            incoming().role == 'member' &&
            incoming().status == 'active' &&
            incoming().permissions.canPostMural == true &&
            incoming().permissions.canUseTactics == true &&
            incoming().permissions.canUseAdvancedTools == false &&
            incoming().permissions.canModerate == false
          )
        );

      allow update: if isVerified() &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email.lower() == existing().email.lower() &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action A: Self profile & presence sync (name/avatar/isOnline/lastSeenAt/updatedAt only — role/status/permissions immutable)
          (
            request.auth.uid == userId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatar', 'isOnline', 'lastSeenAt', 'updatedAt']) &&
            (!('lastSeenAt' in incoming()) || !incoming().diff(existing()).affectedKeys().hasAny(['lastSeenAt']) || incoming().lastSeenAt == request.time)
          ) ||
          // Action B: Owner/Admin moderating another user's role/status/permissions (cannot demote owner)
          (
            isAdmin() &&
            existing().email.lower() != 'tazmaniacrvg@gmail.com' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'permissions', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() &&
        isValidId(userId) &&
        existing().email.lower() != 'tazmaniacrvg@gmail.com';

      // Subcollection: Admin direct messages for this user
      match /messages/{messageId} {
        allow get: if isVerified() && isValidId(userId) && isValidId(messageId) && (request.auth.uid == userId || isAdmin());
        allow list: if isVerified() && (resource.data.recipientUid == request.auth.uid || isAdmin());
        allow create: if isAdmin() &&
          isValidId(userId) &&
          isValidId(messageId) &&
          isValidAdminMessage(incoming()) &&
          incoming().recipientUid == userId &&
          incoming().senderUid == request.auth.uid &&
          incoming().acknowledged == false &&
          incoming().createdAt == request.time;
        allow update: if isVerified() &&
          isValidId(userId) &&
          isValidId(messageId) &&
          request.auth.uid == userId &&
          isValidAdminMessage(incoming()) &&
          incoming().recipientUid == existing().recipientUid &&
          incoming().senderUid == existing().senderUid &&
          incoming().senderName == existing().senderName &&
          incoming().message == existing().message &&
          incoming().createdAt == existing().createdAt &&
          (
            // Action A: Acknowledge message with Ok (no reply)
            (
              existing().acknowledged == false &&
              incoming().acknowledged == true &&
              incoming().acknowledgedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['acknowledged', 'acknowledgedAt'])
            ) ||
            // Action B: Member sends reply before closing modal
            (
              !('replyText' in existing()) &&
              'replyText' in incoming() &&
              incoming().repliedAt == request.time &&
              incoming().acknowledged == existing().acknowledged &&
              incoming().diff(existing()).affectedKeys().hasOnly(['replyText', 'repliedAt'])
            ) ||
            // Action C: Member replies and closes with Ok in one step
            (
              !('replyText' in existing()) &&
              'replyText' in incoming() &&
              existing().acknowledged == false &&
              incoming().acknowledged == true &&
              incoming().acknowledgedAt == request.time &&
              incoming().repliedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['acknowledged', 'acknowledgedAt', 'replyText', 'repliedAt'])
            )
          );
        allow delete: if isAdmin() && isValidId(userId) && isValidId(messageId);
      }

      // Subcollection: Private user tactical saves (Master Gate checking parent ownership)
      match /tactical_data/{docId} {
        allow get: if isVerified() && isValidId(userId) && isValidId(docId) && request.auth.uid == userId;
        allow list: if isVerified() && resource.data.ownerUid == request.auth.uid;
        allow create: if isVerified() &&
          isValidId(userId) &&
          isValidId(docId) &&
          request.auth.uid == userId &&
          isValidTacticalDoc(incoming()) &&
          incoming().ownerUid == request.auth.uid &&
          incoming().updatedAt == request.time;
        allow update: if isVerified() &&
          isValidId(userId) &&
          isValidId(docId) &&
          request.auth.uid == userId &&
          isValidTacticalDoc(incoming()) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().kind == existing().kind &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'updatedAt']);
        allow delete: if isVerified() && isValidId(userId) && isValidId(docId) && request.auth.uid == userId;
      }
    }

    // 1b. Admin Replies Inbox (member responses to direct admin messages)
    match /admin_replies/{replyId} {
      allow get: if isVerified() && isValidId(replyId) && (existing().senderUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.senderUid == request.auth.uid || isAdmin());

      allow create: if isVerified() &&
        isValidId(replyId) &&
        isValidAdminReply(incoming()) &&
        incoming().senderUid == request.auth.uid &&
        incoming().readByAdmin == false &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/messages/$(incoming().parentMessageId));

      allow update: if isAdmin() &&
        isValidId(replyId) &&
        isValidAdminReply(incoming()) &&
        incoming().senderUid == existing().senderUid &&
        incoming().senderName == existing().senderName &&
        incoming().parentMessageId == existing().parentMessageId &&
        incoming().parentMessagePreview == existing().parentMessagePreview &&
        incoming().replyText == existing().replyText &&
        incoming().createdAt == existing().createdAt &&
        existing().readByAdmin == false &&
        incoming().readByAdmin == true &&
        incoming().readAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['readByAdmin', 'readAt']);

      allow delete: if isAdmin() && isValidId(replyId);
    }

    // 2. Site Settings collection (settings/site)
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'site';
      allow create, update: if isAdmin() &&
        isValidId(settingId) &&
        settingId == 'site' &&
        isValidSiteSettings(incoming()) &&
        incoming().updatedAt == request.time;
    }

    // 3. Community Lineups ("Mural da Torcida" - no PII stored)
    match /community_lineups/{lineupId} {
      allow get: if isValidId(lineupId);
      allow list: if true;

      allow create: if isVerified() &&
        isValidId(lineupId) &&
        isValidCommunityLineup(incoming()) &&
        incoming().authorUid == request.auth.uid &&
        incoming().likes == 0 &&
        incoming().publishedAt == request.time &&
        (isAdmin() || canUserPostMural());

      allow update: if isVerified() &&
        isValidId(lineupId) &&
        isValidCommunityLineup(incoming()) &&
        incoming().authorUid == existing().authorUid &&
        incoming().publishedAt == existing().publishedAt &&
        (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['likes']) &&
            incoming().likes == existing().likes + 1
          ) ||
          isAdmin()
        );

      allow delete: if isVerified() &&
        isValidId(lineupId) &&
        (isAdmin() || existing().authorUid == request.auth.uid);
    }

    // Connection test doc (read-only ping)
    match /test/connection {
      allow get: if true;
    }
  }
}
